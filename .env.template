# Arti version to build from the upstream GitLab repository.
# Options:
#   latest        — resolves to the most recent arti-v* release tag at build time
#   arti-v2.0.0   — a specific release tag
#   main          — the current development branch (may be unstable)
ARTI_VERSION=latest

# Target architecture for the container image.
# Options: linux/amd64  linux/arm64  linux/arm/v7
PLATFORM=linux/amd64

# Interface address to bind published ports to.
# 127.0.0.1  — loopback only (this machine only)
# 192.168.x.x — your LAN IP (reachable from local network, not internet)
# 0.0.0.0    — all interfaces (use only behind a firewall)
BIND_ADDR=127.0.0.1

# SOCKS5 proxy port exposed by the container and mapped to the host.
SOCKS_PORT=9150

# HTTP proxy port (Privoxy → Arti SOCKS5). Uncomment COMPOSE_PROFILES to enable.
HTTP_PORT=8118
# COMPOSE_PROFILES=http-proxy
