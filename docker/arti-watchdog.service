# systemd unit — auto-refresh Tor bridges when the arti container goes unhealthy.
#
# Install:
#   sudo cp /home/john/Docker/arti/docker/arti-watchdog.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now arti-watchdog.service
#
# Status / logs:
#   systemctl status arti-watchdog.service
#   journalctl -u arti-watchdog.service -f

[Unit]
Description=Arti bridge watchdog — refresh obfs4 bridges when container is unhealthy
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=john
Group=john
WorkingDirectory=/home/john/Docker/arti

# COOLDOWN: minimum seconds between bridge refresh attempts (default 1800 = 30 min).
Environment=COOLDOWN=1800
Environment=CONTAINER=arti-arti-1

ExecStart=/home/john/Docker/arti/docker/arti-watchdog.sh

# Restart if the docker events stream closes (e.g. Docker daemon restart).
Restart=always
RestartSec=15

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
